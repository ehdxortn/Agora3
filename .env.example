OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_API_SECRET=

OPENAI_DIRECTOR_MODEL=gpt-5.6-sol
OPENAI_SENIOR_MODEL=gpt-5.6-terra
OPENAI_WORKER_MODEL=gpt-5.6-luna
ANTHROPIC_SENIOR_MODEL=claude-sonnet-5
ANTHROPIC_CRITIC_MODEL=claude-opus-5

# Default operating mode: ChatGPT 5.6 Sol in chat is the external controller.
# Each Cloud Run Job performs one bounded research experiment and then PAUSES for review.
CHATGPT_CONTROLLER_MODE=true

RUN_BUDGET_USD=10
DAILY_BUDGET_USD=15
MAX_CYCLES_PER_JOB=100
LITERATURE_MIN_SOURCES=120
MAX_HOLDOUT_EVALUATIONS=12
MIN_EXPERIMENTS_BEFORE_GLOBAL_STOP=12

# Curated-literature mode: ChatGPT/user-curated Supabase research bank only.
# 0 means scout_topic always reuses the stored bank and never pays for API web scouting.
# Controller mode additionally caps each paid research packet to <=10 sources and <=8 failures.
LITERATURE_RETRIEVAL_LIMIT=10
FAILURE_RETRIEVAL_LIMIT=8
TOPIC_REUSE_MIN_SOURCES=0
LITERATURE_MAP_REFRESH_DELTA=20

MIN_OOS_TRADES=80
RARE_EVENT_MIN_VALIDATION_TRADES=20
WALK_FORWARD_FOLDS=3
MIN_POSITIVE_WF_FRACTION=0.67
MIN_EVENT_CLUSTERS=12
COST_STRESS_BPS=20
ROUND_TRIP_FEE_BPS=8
SLIPPAGE_BPS=2
ONCHAIN_LAG_DAYS=2

GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=asia-northeast3
CLOUD_RUN_RESEARCH_JOB=btc-research-job
ENVIRONMENT=prod
